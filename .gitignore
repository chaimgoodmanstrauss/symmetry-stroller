# Defense-in-depth: the real credentials belong at
# ~/.symmetrystroller_deploy.env, outside this repo entirely. These
# patterns just make sure nothing resembling them ever gets committed if
# one ends up inside the repo tree by mistake.
*.env
!deploy.example.env
.deploy_credentials
symmetrystroller.zip
.DS_Store

# Old pre-rewrite prototype files — removed from the repo, not needed going forward
original_symmetry_stroller/

# Field-mode write-endpoint token (see symmetrystroller/api/save.php) —
# lives only on disk here and on the live server, deployed by hand via
# deploy.sh's own api-upload step, never through this repo.
symmetrystroller/api/config.php
